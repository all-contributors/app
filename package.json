{
  "name": "all-contributors-bot",
  "version": "0.0.0-development",
  "private": true,
  "description": "A bot for automatically adding all your contributors",
  "keywords": [
    "all-contributors",
    "probot",
    "github-app",
    "probot-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/all-contributors/app.git"
  },
  "author": "Jake Bolam <jake.bolam@gmail.com> (https://jakebolam.com)",
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "lint": "eslint .",
    "prepare": "simple-git-hooks",
    "start": "probot run ./app.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "allowScripts": {
    "simple-git-hooks": false
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@vitest/eslint-plugin": "^1.6.28",
    "all-contributors-cli": "^7.0.0",
    "commit-conv": "^1.0.3",
    "compromise": "^14.19.0",
    "probot": "^12.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-package-json": "1.14.0",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-yml": "3.10.0",
    "globals": "17.14.0",
    "got": "16.2.0",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "nock": "15.0.6",
    "oxfmt": "0.77.0",
    "pino": "6.14.0",
    "simple-git-hooks": "2.14.0",
    "smee-client": "5.0.0",
    "vercel": "65.12.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
